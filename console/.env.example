VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_MARKETING_URL=https://restart.ng
# Root domain shared with the marketing site, so both can read the same
# session cookie (e.g. ".restart.ng" covers restart.ng and console.restart.ng).
# Leave unset in local dev.
VITE_AUTH_COOKIE_DOMAIN=.restart.ng
